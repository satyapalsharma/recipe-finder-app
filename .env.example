# .env.example for Recipe Finder App

# --- Core Recipe API Configuration ---
# This is the base URL for the external recipe API.
# Replace with the actual base URL of your chosen recipe API (e.g., Spoonacular, Edamam).
# Example: https://api.spoonacular.com
REACT_APP_RECIPE_API_BASE_URL=YOUR_RECIPE_API_BASE_URL

# Your API key for authenticating with the external recipe API.
# Obtain this from your chosen recipe API provider.
REACT_APP_RECIPE_API_KEY=YOUR_RECIPE_API_KEY

# --- Cross-Project / Microservice Context (Optional) ---
# These variables are examples of how this application might interact with or reference
# other services within a larger interconnected system.
# Uncomment and configure if your Recipe Finder App needs to integrate with these
# or if you are running these services locally for development/testing.

# URL for the Task Management App's API.
# This could be used if the Recipe Finder App needed to, for example,
# add a recipe to a meal prep task list managed by the Task Management App.
# REACT_APP_TASK_MANAGER_API_URL=http://localhost:8000/api/tasks

# URL for the Unit Converter App's API.
# This could be used if the Recipe Finder App needed to convert ingredient measurements
# (e.g., grams to ounces, ml to cups) using a dedicated service.
# REACT_APP_UNIT_CONVERTER_API_URL=http://localhost:3001/api/convert

# Base URL for the Online Code Snippet Manager.
# While less directly integrated, this could be a reference point or a link
# if the Recipe Finder App needed to share or access code snippets related to recipes
# (e.g., custom ingredient parsing functions).
# REACT_APP_CODE_SNIPPET_MANAGER_URL=http://localhost:3002/snippets